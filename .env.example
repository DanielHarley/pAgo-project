# Required by NCBI Entrez etiquette.
NCBI_EMAIL=your.email@example.com

# Optional NCBI API key. Leave empty if you do not have one.
NCBI_API_KEY=

# Optional TLS certificate overrides for restricted networks.
NCBI_SSL_CERT_FILE=
NCBI_SSL_CERT_DIR=

# Project paths used by local scripts and notebooks.
PAGO_PROJECT_ROOT=.
PAGO_DATA_ROOT=data
