.env

# IDEs
.idea/
*.iml
.cursor/
.codex/
llm/

# venv
.venv/
venv/

# Python
__pycache__/
*.py[cod]

# Data / outputs
data/*
*.csv
*.fasta
*.fa
*.dat
*.npz
*.html
!data/01-raw/
!data/01-raw/**

# Resumable NCBI XML batch workspace: large, regenerable, and never an artifact.
# This must follow the data/01-raw negations above, because the last matching
# pattern wins and those negations would otherwise re-include it. It also has to
# stay out of git-lfs, which claims every .xml under protein_xml_snapshots.
**/.batch_workspace/

# Immutable NCBI snapshot runs. Every pipeline run leaves one directory here,
# each a regenerable multi-hundred-MB artifact routed into git-lfs. Only the
# curated runs that latest/ points at belong in the repository, so they are
# re-included by name below. Like the rule above, this must follow the
# data/01-raw negations, because the last matching pattern wins.
#
# Publishing a run is deliberate: add a "!" line for it here, then git add it.
# The pattern excludes each RUN directory rather than the snapshots/ parent, so
# that these negations can take effect at all -- git cannot re-include anything
# beneath an excluded directory.
data/01-raw/*/snapshots/*/
!data/01-raw/protein_uid_snapshots/snapshots/2026-04-06T20-42-12Z__q_891f443d754c/
!data/01-raw/protein_xml_snapshots/snapshots/2026-04-09T00-51-02Z__q_891f443d754c/

# Test runtime artifacts
.pytest_cache/
.coverage
htmlcov/

# Curated test fixtures and pinned reference data are versioned even though the
# blanket *.csv / *.fasta rules above would otherwise ignore them.
!tests/fixtures/
!tests/fixtures/**
!src/pago_pipeline/resources/
!src/pago_pipeline/resources/**

# SWeeP original (intellectual property — must not be committed)
scripts/sweep-2.1.3.0/
